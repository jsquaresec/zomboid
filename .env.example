# Copy this file to .env on the VPS. Never commit .env.
SERVER_NAME=MayheM Zomboid
SERVER_PASSWORD=change_this_join_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

# Tuned for a 4-vCPU / 8-GB VPS. Leave memory for Linux and Docker.
MAX_MEMORY=5g
MAX_PLAYERS=16
PUBLIC=true
PVP=true
PAUSE_EMPTY=true
AUTOSAVE_INTERVAL=15
BACKUPS_PERIOD=120
BACKUPS_COUNT=12
PING_LIMIT=400
STEAM_VAC=true

# Stable Build 41: leave blank. Build 42 testing: set to unstable.
BETA_BRANCH=

# Semicolon-separated Workshop IDs and matching in-game Mod IDs.
MOD_IDS=
MOD_NAMES=
